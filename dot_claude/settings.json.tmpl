{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
  },
  "permissions": {
    "allow": [
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(ghq list:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-tree:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(go build:*)",
      "Bash(go get:*)",
      "Bash(go mod init:*)",
      "Bash(go version:*)",
      "Bash(grep:*)",
      "Bash(kind get:*)",
      "Bash(kustomize build:*)",
      "Bash(limactl create:*)",
      "Bash(limactl shell:*)",
      "Bash(limactl start:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Bash(aws:*)",
      "Bash(find:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr comment:*)",
      "Bash(git pu:*)",
      "Bash(git push:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
{{- if (eq .chezmoi.os "darwin") }}
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(basename \"$PWD\") && osascript -e \"display notification \\\"Claude Codeが許可を求めています\\\" with title \\\"Claude Code\\\" subtitle \\\"確認待ち - $DIR\\\" sound name \\\"Glass\\\"\""
          }
        ]
      }
{{- end }}
    ],
    "Stop": [
{{- if (eq .chezmoi.os "darwin") }}
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); case \"$INPUT\" in *'\"agent_id\"'*) exit 0 ;; esac; DIR=$(basename \"$PWD\") && osascript -e \"display notification \\\"タスクが完了しました\\\" with title \\\"Claude Code\\\" subtitle \\\"処理終了 - $DIR\\\" sound name \\\"Hero\\\"\""
          }
        ]
      }
{{- end }}
    ]{{ if not .isWork }},
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ]
{{- end }}
  },
  "statusLine": {
    "type": "command",
    "command": "~/ghq/github.com/chez-shanpu/cc-o11y-stack/scripts/statusline.sh | ~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "modern-go-guidelines@goland-claude-marketplace": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "goland-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "JetBrains/go-modern-guidelines"
      }
    }
  },
  "language": "japanese",
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "opus",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(git push --force:*) in chez-shanpu/dotfiles",
      "Bash(gh pr comment:*)",
      "Bash(gh issue comment:*)"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PUBLIC — chez-shanpu/dotfiles (github.com/chez-shanpu/dotfiles). Any push here is publishing.",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Default branch main; no protected branches or rulesets listed (per gh)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet; hosts observed in use: host.docker.internal, api.anthropic.com, bridge.claudeusercontent.com, gateway.docker.internal",
      "**Source control**: The trusted repo (chez-shanpu/dotfiles) and its origin remote only (no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (personal dotfiles management via chezmoi)",
      "**Trusted repo**: chez-shanpu/dotfiles (working directory /Users/shanpu/ghq/github.com/chez-shanpu/dotfiles), public — only this repo's own work should be pushed there; content ported or first read from outside this session's repo is not its own work",
      "**Org-specific CLIs**: None configured — routine non-standard CLI usage observed in this project: sbx, chezmoi, fish, yq, codex, claude"
    ]
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754037278403
  }
}
