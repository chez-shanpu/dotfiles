{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-tree:*)",
      "Bash(git status:*)",
      "Bash(go build:*)",
      "Bash(go get:*)",
      "Bash(go mod init:*)",
      "Bash(go version:*)",
      "Bash(grep:*)",
      "Bash(kind get:*)",
      "Bash(kustomize build:*)",
      "Bash(limactl create:*)",
      "Bash(limactl shell:*)",
      "Bash(limactl start:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Bash(find:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr comment:*)",
      "Bash(git cm:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(python3:*)"
    ]
  },
  "hooks": {
    "Notification": [
{{- if (eq .chezmoi.os "darwin") }}
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(basename \"$PWD\") && osascript -e \"display notification \\\"Claude Codeが許可を求めています\\\" with title \\\"Claude Code\\\" subtitle \\\"確認待ち - $DIR\\\" sound name \\\"Glass\\\"\""
          }
        ]
      }
{{- end }}
    ],
    "Stop": [
{{- if (eq .chezmoi.os "darwin") }}
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); case \"$INPUT\" in *'\"agent_id\"'*) exit 0 ;; esac; DIR=$(basename \"$PWD\") && osascript -e \"display notification \\\"タスクが完了しました\\\" with title \\\"Claude Code\\\" subtitle \\\"処理終了 - $DIR\\\" sound name \\\"Hero\\\"\""
          }
        ]
      }
{{- end }}
    ]
  },
  "statusLine": {
    "type": "command",
{{- if .isWork }}
    "command": "CLAUDE_STATUSLINE_NO_USAGE=1 bash ~/.claude/statusline.sh"
{{- else }}
    "command": "bash ~/.claude/statusline.sh"
{{- end }}
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "awaySummaryEnabled": false,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754037278403
  },
  "skipWorkflowUsageWarning": true
}
