{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
  },
  "permissions": {
    "allow": [
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(ghq list:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-tree:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(go build:*)",
      "Bash(go get:*)",
      "Bash(go mod init:*)",
      "Bash(go version:*)",
      "Bash(grep:*)",
      "Bash(kind get:*)",
      "Bash(kustomize build:*)",
      "Bash(limactl create:*)",
      "Bash(limactl shell:*)",
      "Bash(limactl start:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Bash(aws:*)",
      "Bash(find:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr comment:*)",
      "Bash(git cm:*)",
      "Bash(git commit:*)",
      "Bash(git pu:*)",
      "Bash(git push:*)",
      "Bash(python3:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
{{- if (eq .chezmoi.os "darwin") }}
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(basename \"$PWD\") && osascript -e \"display notification \\\"Claude Codeが許可を求めています\\\" with title \\\"Claude Code\\\" subtitle \\\"確認待ち - $DIR\\\" sound name \\\"Glass\\\"\""
          }
        ]
      }
{{- end }}
    ],
    "Stop": [
{{- if (eq .chezmoi.os "darwin") }}
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); case \"$INPUT\" in *'\"agent_id\"'*) exit 0 ;; esac; DIR=$(basename \"$PWD\") && osascript -e \"display notification \\\"タスクが完了しました\\\" with title \\\"Claude Code\\\" subtitle \\\"処理終了 - $DIR\\\" sound name \\\"Hero\\\"\""
          }
        ]
      }
    ],
{{- if not .isWork }}
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh"
          }
        ]
{{- end }}
      }
{{- end }}
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/ghq/github.com/chez-shanpu/cc-o11y-stack/scripts/statusline.sh | ~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
  },
  "language": "japanese",
  "agentPushNotifEnabled": true,
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754037278403
  }
}
